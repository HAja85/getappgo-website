# Template for the private mail settings of the contact form.
# Copy to the hosting account root as .env — the directory that contains
# public_html, not a file inside public_html or this project's public folder.
# Never commit the real .env. Do not prefix these names with VITE_.
# The React app does not read this file.

SMTP_HOST=zillionxai.com
SMTP_PORT=465
SMTP_USER=info@zillionxai.com
SMTP_PASS=replace-with-mailbox-password
SMTP_TO=services@zillionxai.com
SMTP_FROM=info@zillionxai.com
